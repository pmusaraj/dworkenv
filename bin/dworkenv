#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "json"
require "net/http"
require "open3"
require "optparse"
require "pathname"
require "shellwords"
require "time"
require "yaml"
require_relative "../lib/dworkenv/preview_assets"
require_relative "../lib/dworkenv/public_endpoint"
require_relative "../lib/dworkenv/tailscale"

class DiscourseProject
  attr_reader :root, :discourse_root, :plugin_name, :state_directory

  def initialize
    @root = File.realpath(git("rev-parse", "--show-toplevel").strip)
    if File.file?(File.join(@root, "plugin.rb"))
      @plugin_name = File.read(File.join(@root, "plugin.rb"))[/^#\s*name:\s*([^\r\n]+)/, 1]&.strip
      unless @plugin_name&.match?(/\A[a-zA-Z0-9][a-zA-Z0-9_-]*\z/)
        raise "plugin.rb must declare a name containing only letters, numbers, underscores, and hyphens"
      end
      cache = ENV["DWORKENV_CACHE_HOME"] || File.join(ENV.fetch("XDG_CACHE_HOME", File.join(Dir.home, ".cache")), "dworkenv")
      @state_directory = File.join(File.expand_path(cache), Digest::SHA256.hexdigest(@root)[0, 16])
      @discourse_root = File.join(@state_directory, "discourse")
    elsif File.file?(File.join(@root, ".devcontainer/devcontainer.json")) && File.file?(File.join(@root, "bin/rspec"))
      @discourse_root = @root
      @state_directory = File.join(@root, "tmp/workenv")
    else
      raise "Run dworkenv from a Discourse checkout or a plugin repository containing plugin.rb"
    end
  end

  def container_name
    branch = git("branch", "--show-current").strip
    branch = File.basename(@root) if branch.empty?
    pr = branch.match(/(?:\A|[\/_-])(?:pr|pull)[\/_-]?(\d+)(?:\z|[\/_-])/i)
    feature = pr ? "PR-#{pr[1]}" : branch.gsub(/[^a-zA-Z0-9-]+/, "-").gsub(/-+/, "-").sub(/\A-/, "").sub(/-\z/, "")
    feature = "checkout" if feature.empty?
    prefix = plugin? ? "discourse-#{@plugin_name.delete_prefix("discourse-")}" : "discourse"
    "#{prefix}-#{feature}"[0, 180]
  end

  def plugin?
    !@plugin_name.nil?
  end

  def ensure_checkout
    return unless plugin?
    return if File.directory?(File.join(@discourse_root, ".git"))
    raise "Managed checkout exists without Git metadata: #{@discourse_root}" if File.exist?(@discourse_root)

    repository = ENV.fetch("DWORKENV_DISCOURSE_REPOSITORY", "https://github.com/discourse/discourse.git")
    ref = ENV.fetch("DWORKENV_DISCOURSE_REF", "main")
    temporary = File.join(@state_directory, "discourse-cloning")
    raise "Interrupted clone found at #{temporary}; remove it before retrying" if File.exist?(temporary)
    warn "Preparing Discourse #{ref} for #{@plugin_name}..."
    begin
      git("init", "--quiet", temporary)
      git("-C", temporary, "remote", "add", "origin", repository)
      git("-C", temporary, "fetch", "--depth=1", "origin", ref)
      git("-C", temporary, "checkout", "--detach", "--quiet", "FETCH_HEAD")
      unless File.file?(File.join(temporary, ".devcontainer/devcontainer.json")) && File.file?(File.join(temporary, "bin/rspec"))
        raise "The selected Discourse revision does not provide the development environment files"
      end
      File.rename(temporary, @discourse_root)
      warn "Discourse revision: #{git("-C", @discourse_root, "rev-parse", "HEAD").strip}"
    ensure
      FileUtils.rm_rf(temporary)
    end
  end

  def spec_arguments(arguments)
    paths, options = split_specs(arguments)
    paths = paths.map { |path| plugin? ? "plugins/#{@plugin_name}/#{path.delete_prefix("#{@root}/")}" : path }
    [*paths, *options]
  end

  def system_specs?(arguments)
    paths, = split_specs(arguments)
    paths.any? do |argument|
      path = argument.sub(/:\d+(?::\d+)*\z/, "")
      path = File.expand_path(path, @root)
      pattern = File.directory?(path) ? File.join(path, "**/*_spec.rb") : path
      Dir.glob(pattern).any? { |file| file.include?("/spec/system/") }
    end
  end

  private

  def split_specs(arguments)
    separator = arguments.index("--") || arguments.length
    paths = arguments.take(separator)
    options = arguments.drop(separator + 1)
    raise "Put RSpec options after -- (for example: dworkenv test spec/models -- --format progress)" if paths.any? { |path| path.start_with?("-") }
    paths = ["spec"] if paths.empty?
    [paths, options]
  end

  def git(*arguments)
    output, status = Open3.capture2("git", *arguments)
    raise "Git command failed: #{arguments.first}" unless status.success?
    output
  end
end

class WorktreeEnvironment
  LABEL = "org.discourse.workenv.path"
  WORKSPACE = "/workspace/discourse"

  def initialize
    @project = DiscourseProject.new
    @root = @project.root
    @source = @project.discourse_root
    @volume_prefix = "discourse-workenv-#{Digest::SHA256.hexdigest(@root)[0, 16]}"
    @name = @project.container_name
  end

  def run(command, arguments)
    spec_arguments = @project.spec_arguments(arguments) if command == "test"
    FileUtils.mkdir_p(@project.state_directory)
    File.open(File.join(@project.state_directory, "lock"), "w") do |lock|
      lock.flock(File::LOCK_EX)
      @settings = File.file?(settings_path) ? JSON.parse(File.read(settings_path)) : {}
      configure_start(arguments) if command == "up"
      case command
      when "up"
        start
        prepare
        if @settings["tailscale"]
          @settings["tailscale_url"] = tailscale.start(container, LABEL)
          save_settings
        end
        start_web
        puts url
      when "exec", "test", "qunit"
        start
        prepare
        if command == "qunit" || (command == "test" && @project.system_specs?(arguments))
          prepare_browser
          start_web
        end
      when "url"
        puts url
      when "stop"
        tailscale.stop
        docker("stop", @name) if container
      when "destroy"
        tailscale.destroy
        docker("rm", "--force", @name) if container
        volumes =
          capture("docker", "volume", "ls", "--quiet", "--filter", "label=#{LABEL}=#{@root}").split
        docker("volume", "rm", *volumes) unless volumes.empty?
        FileUtils.rm_f(settings_path)
        FileUtils.rm_rf(@source) if @project.plugin?
      end
    end

    if %w[exec test qunit].include?(command)
      arguments.shift if command != "test" && arguments.first == "--"
      arguments = ["bin/rspec", *spec_arguments] if command == "test"
      if command == "qunit"
        arguments = ["bash", "-ec", <<~SH, "dworkenv-qunit", *arguments]
          export GIT_ALTERNATE_OBJECT_DIRECTORIES="$(git rev-parse --path-format=absolute --git-common-dir)/objects"
          export GIT_OBJECT_DIRECTORY=/home/discourse/.cache/dworkenv/git-objects
          export DISCOURSE_DISABLE_BROWSER_SANDBOX=1
          mkdir -p "$GIT_OBJECT_DIRECTORY"
          exec bin/qunit --standalone --target #{@project.plugin_name || "core"} "$@"
        SH
      end
      flags = $stdin.tty? && $stdout.tty? ? ["-it"] : ["-i"]
      exec(
        "docker",
        "exec",
        *flags,
        "--user",
        "discourse",
        "--workdir",
        WORKSPACE,
        *plugin_environment,
        @name,
        *arguments,
      )
    end
  end

  private

  def settings_path
    File.join(@project.state_directory, "preview.json")
  end

  def save_settings
    File.write("#{settings_path}.new", JSON.pretty_generate(@settings))
    File.rename("#{settings_path}.new", settings_path)
  end

  def configure_start(arguments)
    settings = @settings.dup
    options = OptionParser.new do |parser|
      parser.on("--preview") { settings["preview"] = true }
      parser.on("--live") { settings["preview"] = false }
      parser.on("--tailscale") { settings["tailscale"] = true; settings.delete("public_url") }
      parser.on("--no-tailscale") { settings["tailscale"] = false; settings.delete("tailscale_url") }
      parser.on("--public-url URL") do |value|
        settings["public_url"] = Dworkenv::PublicEndpoint.new(value).to_s
        settings["tailscale"] = false
        settings.delete("tailscale_url")
      end
      parser.on("--local") do
        settings["tailscale"] = false
        settings.delete("public_url")
        settings.delete("tailscale_url")
      end
    end
    options.parse!(arguments)
    raise "Unexpected arguments" unless arguments.empty?
    tailscale.stop if @settings["tailscale"] && !settings["tailscale"]
    @settings = settings
    save_settings
  end

  def tailscale
    @tailscale ||= Dworkenv::Tailscale.new(@root, @volume_prefix)
  end

  def capture(*command)
    output, status = Open3.capture2(*command)
    raise "Command failed: #{command.first(2).join(" ")}" unless status.success?
    output
  end

  def docker(*arguments)
    unless system("docker", *arguments, out: $stderr)
      raise "Docker command failed: #{arguments.first}"
    end
  end

  def container
    ids = capture("docker", "ps", "--all", "--quiet", "--filter", "label=#{LABEL}=#{@root}").split
    raise "Multiple containers belong to this checkout" if ids.length > 1
    return if ids.empty?
    info = JSON.parse(capture("docker", "inspect", ids.first)).first
    @name = info.fetch("Name").delete_prefix("/")
    info
  end

  def available_name
    desired = @project.container_name
    ids = capture("docker", "ps", "--all", "--quiet", "--filter", "name=^/#{desired}$").strip
    if !ids.empty? && JSON.parse(capture("docker", "inspect", ids)).first.dig("Config", "Labels", LABEL) != @root
      desired = "#{desired}-#{Digest::SHA256.hexdigest(@root)[0, 8]}"
    end
    desired
  end

  def ensure_image(image)
    cache = ENV["DWORKENV_CACHE_HOME"] || File.join(ENV.fetch("XDG_CACHE_HOME", File.join(Dir.home, ".cache")), "dworkenv")
    directory = File.join(File.expand_path(cache), "images")
    FileUtils.mkdir_p(directory)
    key = Digest::SHA256.hexdigest(image)
    File.open(File.join(directory, "#{key}.lock"), "w") do |lock|
      lock.flock(File::LOCK_EX)
      marker = File.join(directory, "#{key}.json")
      output, _error, status = Open3.capture3("docker", "image", "inspect", image)
      info = JSON.parse(output).first if status.success?
      checked = JSON.parse(File.read(marker)) if File.file?(marker)
      since = Time.parse(info.fetch("Created")) if info
      if info && checked && checked["id"] == info["Id"]
        since = [since, Time.at(checked.fetch("checked_at"))].max
      end
      return if since && since <= Time.now && Time.now - since <= 48 * 60 * 60

      docker("pull", image)
      info = JSON.parse(capture("docker", "image", "inspect", image)).first
      File.write(marker, JSON.generate(id: info.fetch("Id"), checked_at: Time.now.to_f))
    end
  end

  def volume_mounts
    packages = YAML.safe_load_file("#{@source}/pnpm-workspace.yaml").fetch("packages")
    dependency_paths =
      ["node_modules"] +
        packages.flat_map do |pattern|
          Dir.glob(pattern, base: @source).map { |path| "#{path}/node_modules" }
        end
    mounts = {
      "postgres" => "/shared/postgres_data",
      "redis" => "/shared/redis_data",
      "gems" => "/home/discourse/.bundle/gems",
      "cache" => "/home/discourse/.cache",
      "tmp" => "#{WORKSPACE}/tmp",
      "log" => "#{WORKSPACE}/log",
    }
    dependency_paths.each do |path|
      mounts["node-#{Digest::SHA256.hexdigest(path)[0, 12]}"] = "#{WORKSPACE}/#{path}"
    end
    if @project.plugin?
      %w[gems auto_generated node_modules].each do |directory|
        target = "#{plugin_path}/#{directory}"
        mounts["plugin-#{directory}"] = target unless mounts.value?(target)
      end
    end
    mounts
  end

  def plugin_path
    "#{WORKSPACE}/plugins/#{@project.plugin_name}"
  end

  def plugin_environment
    return [] unless @project.plugin?
    ["--env", "LOAD_PLUGINS=1", "--env", "DWORKENV_PLUGIN_PATH=#{plugin_path}"]
  end

  def git_mounts(root, target)
    common = capture("git", "-C", root, "rev-parse", "--path-format=absolute", "--git-common-dir").strip
    mounts = ["--mount", "type=bind,source=#{common},target=#{common},readonly"]
    if File.directory?("#{root}/.git")
      mounts.concat(["--mount", "type=bind,source=#{common},target=#{target}/.git,readonly"])
    end
    mounts
  end

  def linked_plugins
    Dir.glob("#{@source}/plugins/*").filter_map do |path|
      next unless File.symlink?(path)
      raise "Broken plugin symlink: #{path}" unless File.directory?(path)
      real = File.realpath(path)
      raise "Linked plugin has no plugin.rb: #{path}" unless File.file?(File.join(real, "plugin.rb"))
      # Relative links inside the checkout already resolve through its bind mount.
      next if !Pathname.new(File.readlink(path)).absolute? && real.start_with?("#{@source}/")
      target = File.expand_path(File.readlink(path), File.dirname(path).sub(@source, WORKSPACE))
      protected = %w[/etc /usr /bin /sbin /proc /sys /dev /run /shared /home/discourse]
      if %w[/ /home /workspace].include?(target) || protected.any? { |prefix| target == prefix || target.start_with?("#{prefix}/") }
        raise "Unsafe plugin symlink target: #{target}"
      end
      [real, target]
    end.uniq
  end

  def start
    @project.ensure_checkout
    if info = container
      desired = available_name
      if @name != desired
        docker("rename", @name, desired)
        @name = desired
      end
      docker("start", @name) unless info.dig("State", "Running")
    else
      @name = available_name
      config = File.read("#{@source}/.devcontainer/devcontainer.json")
      image = ENV["DWORKENV_IMAGE"] || ENV["WORKENV_IMAGE"] || config[/"image"\s*:\s*"([^"]+)"/, 1]
      raise "No development image configured" unless image
      ensure_image(image)
      mounts = volume_mounts
      arguments = [
        "run",
        "--detach",
        "--name",
        @name,
        "--label",
        "#{LABEL}=#{@root}",
        "--label",
        "dev.orbstack.http-port=3000",
        "--publish",
        "127.0.0.1::3000",
        "--shm-size",
        "1g",
        "--workdir",
        WORKSPACE,
        "--env",
        "HOME=/home/discourse",
        "--env",
        "PGUSER=discourse",
        "--env",
        "UNICORN_BIND_ALL=1",
        "--env",
        "UNICORN_WORKERS=2",
        "--env",
        "RAILS_DEVELOPMENT_HOSTS=localhost,127.0.0.1",
        "--env",
        "BUNDLE_APP_CONFIG=/home/discourse/.bundle",
        "--env",
        "BUNDLE_PATH=/home/discourse/.bundle/gems",
        "--mount",
        "type=bind,source=#{@source},target=#{WORKSPACE}",
      ]
      arguments.concat(git_mounts(@source, WORKSPACE))
      linked_plugins.each do |source, target|
        arguments.concat(["--mount", "type=bind,source=#{source},target=#{target}"])
        _output, _error, git_status = Open3.capture3("git", "-C", source, "rev-parse", "--git-dir")
        if git_status.success?
          git_mounts(source, target).each_slice(2) do |flag, mount|
            arguments.concat([flag, mount]) unless arguments.include?(mount)
          end
        end
        %w[node_modules gems auto_generated].each do |directory|
          mounts["linked-#{Digest::SHA256.hexdigest(target)[0, 12]}-#{directory}"] = "#{target}/#{directory}"
        end
      end
      if @project.plugin?
        arguments.concat(["--mount", "type=bind,source=#{@root},target=#{plugin_path}"])
        arguments.concat(git_mounts(@root, plugin_path))
        arguments.concat(plugin_environment)
      end
      arguments.concat(
        [
          "--env",
          "GIT_CONFIG_COUNT=#{@project.plugin? ? 2 : 1}",
          "--env",
          "GIT_CONFIG_KEY_0=safe.directory",
          "--env",
          "GIT_CONFIG_VALUE_0=#{WORKSPACE}",
        ],
      )
      if @project.plugin?
        arguments.concat(["--env", "GIT_CONFIG_KEY_1=safe.directory", "--env", "GIT_CONFIG_VALUE_1=#{plugin_path}"])
      end
      mounts.each do |suffix, target|
        volume = "#{@volume_prefix}-#{suffix}"
        capture("docker", "volume", "create", "--label", "#{LABEL}=#{@root}", volume)
        arguments.concat(["--mount", "type=volume,source=#{volume},target=#{target}"])
      end
      docker(*arguments, image, "/sbin/boot")
    end
    mounted =
      container
        .fetch("Mounts")
        .select { |mount| mount["Type"] == "volume" }
        .map { |mount| mount["Destination"] }
    links = container.fetch("Mounts").select { |mount| mount["Type"] == "bind" }
    linked_plugins.each do |source, target|
      unless links.any? { |mount| mount["Source"] == source && mount["Destination"] == target }
        raise "Linked plugins changed; recreate the environment to update their mounts"
      end
    end
    unless (volume_mounts.values - mounted).empty?
      raise "Workspace packages changed; destroy and recreate this environment to isolate their dependencies"
    end
    writable = mounted.reject { |path| path.start_with?("/shared/") }
    docker("exec", @name, "chown", "discourse:discourse", *writable)
    docker("exec", @name, "bash", "-ec", <<~SH)
      for attempt in {1..60}; do
        if pg_isready -q && redis-cli ping | grep -q PONG; then exit 0; fi
        sleep 1
      done
      echo 'PostgreSQL or Redis did not become ready' >&2
      exit 1
    SH
  end

  def inside(*arguments)
    docker("exec", "--user", "discourse", "--workdir", WORKSPACE, *plugin_environment, @name, *arguments)
  end

  def prepare
    files = %w[Gemfile.lock pnpm-lock.yaml pnpm-workspace.yaml]
    files += Dir.glob("{db/migrate,db/post_migrate}/*.rb", base: @source)
    fingerprint = Digest::SHA256.new
    fingerprint.update("admin-seed-v1")
    files.sort.each { |path| fingerprint.update(path).update(File.read("#{@source}/#{path}")) }
    if @project.plugin?
      fingerprint.update("plugin-environment-v1")
      files = %w[plugin.rb Gemfile Gemfile.lock package.json pnpm-lock.yaml]
      files += Dir.glob("{db/migrate,db/post_migrate}/*.rb", base: @root)
      files.sort.each do |path|
        fingerprint.update("plugin/#{path}").update(File.read("#{@root}/#{path}")) if File.file?("#{@root}/#{path}")
      end
    end
    linked_plugins.each do |source, _target|
      Dir.glob("{plugin.rb,Gemfile*,package.json,pnpm-lock.yaml,db/{migrate,post_migrate}/*.rb}", base: source).sort.each do |path|
        fingerprint.update(source).update(path).update(File.read(File.join(source, path))) if File.file?(File.join(source, path))
      end
    end
    inside("bash", "-ec", <<~SH, "workenv", fingerprint.hexdigest)
      marker=/home/discourse/.workenv-ready
      if [ -f "$marker" ] && [ "$(cat "$marker")" = "$1" ]; then exit 0; fi
      bundle check || bundle install --jobs 4
      CI=1 pnpm install --frozen-lockfile
      if [ -n "${DWORKENV_PLUGIN_PATH:-}" ] && [ -f "$DWORKENV_PLUGIN_PATH/package.json" ]; then
        if [ -f "$DWORKENV_PLUGIN_PATH/pnpm-lock.yaml" ]; then
          (cd "$DWORKENV_PLUGIN_PATH" && CI=1 pnpm --ignore-workspace install --frozen-lockfile --store-dir /home/discourse/.cache/pnpm-store)
        else
          (cd "$DWORKENV_PLUGIN_PATH" && CI=1 pnpm --ignore-workspace install --lockfile=false --store-dir /home/discourse/.cache/pnpm-store)
        fi
      fi
      SKIP_MULTISITE=1 SKIP_TEST_DATABASE=1 bin/rake db:create db:migrate
      RAILS_ENV=test bin/rake db:create db:migrate
      RAILS_ENV=development bin/rails runner - <<'DWORKENV_ADMIN'
#{admin_seed}DWORKENV_ADMIN
      printf '%s' "$1" > "$marker"
    SH
  end

  def admin_seed
    <<~RUBY
      User.transaction do
        next if User.find_by(username_lower: "admin")
        user = User.new(username: "admin", email: "admin@localhost.local", name: "Admin",
                        password: SecureRandom.hex(32), active: true, approved: true,
                        approved_at: Time.current, trust_level: 1)
        user.save!
        # Set the requested local password without changing site password policy.
        user.user_password.password = "passwordpassword"
        user.user_password.save!(validate: false)
        user.grant_admin!
        user.activate
      end
    RUBY
  end

  def asset_snapshot
    script = File.read(File.expand_path("../lib/dworkenv/preview_assets.rb", __dir__))
    output, error, result = Open3.capture3(
      "docker", "exec", "-i", "--user", "discourse", "--workdir", WORKSPACE,
      @name, "ruby", "-", stdin_data: script + "\nputs JSON.generate(Dworkenv::PreviewAssets.snapshot)\n",
    )
    raise "Could not fingerprint preview assets: #{error}" unless result.success?
    JSON.parse(output).merge("image" => container.fetch("Image"))
  end

  def prepare_preview
    current = asset_snapshot
    marker = "/home/discourse/.cache/dworkenv-preview.json"
    output, _error, result = Open3.capture3("docker", "exec", @name, "cat", marker)
    begin
      previous = JSON.parse(output) if result.success?
    rescue JSON::ParserError
      previous = nil
    end
    if Dworkenv::PreviewAssets.reusable?(current, previous)
      warn "Source unchanged; reusing preview assets."
    else
      warn "Building preview assets once..."
      docker("exec", @name, "sh", "-ec", "if [ -f /etc/service/workenv-web/run ]; then sv -w 30 down /etc/service/workenv-web; fi")
      inside("rm", "-f", marker)
      inside("pnpm", "--dir", "frontend/discourse", "build")
      built = asset_snapshot
      unless built["source"] == current["source"] && built["complete"]
        raise "Source changed during the build or assets are incomplete; rerun dworkenv up"
      end
      inside("sh", "-ec", 'mkdir -p /home/discourse/.cache; printf "%s" "$1" > "$2"', "preview-cache", JSON.generate(built), marker)
    end
    # A live build's PID must not survive the transition to a static preview.
    docker("exec", @name, "sh", "-ec", <<~SH)
      if [ -f /etc/service/workenv-web/run ] && ! grep -q 'bin/dev --only=rails' /etc/service/workenv-web/run; then
        sv -w 30 down /etc/service/workenv-web
      fi
    SH
    inside("sh", "-ec", 'printf \'{"status":"ok"}\n\' > frontend/discourse/dist/manifest/build.json')
  end

  def start_web
    prepare_preview if @settings["preview"]
    endpoint = Dworkenv::PublicEndpoint.new(url)
    hostname = endpoint.hostname
    docker("exec", @name, "bash", "-ec", <<~SH)
      mkdir -p /etc/service/workenv-web
      cat > /etc/service/workenv-web/run.new <<'RUN'
      #!/bin/sh
      cd #{WORKSPACE}
      export RAILS_DEVELOPMENT_HOSTS=#{Shellwords.escape("localhost,127.0.0.1,#{@name}.orb.local,#{hostname}")}
      export DISCOURSE_HOSTNAME=#{Shellwords.escape(hostname)}
      export DISCOURSE_PORT=#{endpoint.uri.port}
      export DISCOURSE_FORCE_HTTPS=#{endpoint.https? ? 1 : 0}
      export DISCOURSE_DEV_ALLOW_HTTPS=1
      exec chpst -u discourse:discourse bin/dev#{@settings["preview"] ? " --only=rails" : ""} >> log/workenv-web.log 2>&1
      RUN
      action=up
      if ! cmp -s /etc/service/workenv-web/run.new /etc/service/workenv-web/run; then
        if [ -f /etc/service/workenv-web/run ]; then action=restart; fi
        chmod +x /etc/service/workenv-web/run.new
        mv /etc/service/workenv-web/run.new /etc/service/workenv-web/run
      else
        rm /etc/service/workenv-web/run.new
      fi
      for attempt in {1..10}; do
        if sv -w 30 "$action" /etc/service/workenv-web; then exit 0; fi
        sleep 1
      done
      exit 1
    SH
    inside("bin/rake", "assets:precompile:build_plugins") if @project.plugin?
    warn "Waiting for #{url} (logs: docker exec #{@name} tail -f #{WORKSPACE}/log/workenv-web.log)..."
    # Reach the local backend even when the public origin is a remote TLS proxy.
    address = URI("http://127.0.0.1:#{published_port}")
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 240
    loop do
      begin
        response =
          Net::HTTP.start(
            address.host,
            address.port,
            nil,
            open_timeout: 2,
            read_timeout: 5,
          ) do |http|
            http.get("/", {
              "Host" => "#{hostname}:#{endpoint.uri.port}",
              "X-Forwarded-Proto" => endpoint.uri.scheme,
              "User-Agent" => "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36",
            })
          end
        return if response.code.to_i == 200
      rescue SystemCallError, IOError, Timeout::Error, SocketError
      end
      if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
        raise "Web server did not become ready; inspect log/workenv-web.log"
      end
      sleep 2
    end
  end

  def prepare_browser
    fingerprint = Digest::SHA256.file("#{@source}/pnpm-lock.yaml").hexdigest
    inside("bash", "-ec", <<~SH, "dworkenv-browser", fingerprint)
      marker=/home/discourse/.workenv-browser-ready
      if [ ! -f "$marker" ] || [ "$(cat "$marker")" != "$1" ]; then
        pnpm playwright-install
        sudo pnpm exec playwright install-deps chromium
        printf '%s' "$1" > "$marker"
      fi
      chromium=$(node -e 'process.stdout.write(require("playwright").chromium.executablePath())')
      sudo ln -sfn "$chromium" /usr/bin/google-chrome
    SH
  end

  def url
    info = container
    raise "Environment is not running; use dworkenv up" unless info&.dig("State", "Running")
    if @settings["tailscale"]
      return @settings.fetch("tailscale_url") { raise "Tailscale is not ready; run dworkenv up" }
    end
    return @settings["public_url"] if @settings["public_url"]
    return "https://#{@name}.orb.local" if orbstack?
    port = info&.dig("NetworkSettings", "Ports", "3000/tcp")&.first&.fetch("HostPort")
    raise "Environment is not running; use dworkenv up" unless port
    "http://localhost:#{port}"
  end

  def published_port
    container.dig("NetworkSettings", "Ports", "3000/tcp")&.first&.fetch("HostPort") || raise("No published HTTP port")
  end

  def orbstack?
    @operating_system ||= capture("docker", "info", "--format", "{{.OperatingSystem}}").strip
    @operating_system == "OrbStack"
  end
end

if $PROGRAM_NAME == __FILE__
  command = ARGV.shift
  unless %w[up exec test qunit url stop destroy auth-key].include?(command)
    puts <<~HELP
      Usage: dworkenv <up|exec|test|qunit|url|stop|destroy|auth-key>

        up                 Prepare this worktree and start its web server
        exec -- COMMAND    Prepare this worktree and run a command inside it
        test [SPECS...]     Run RSpec; pass runner options after --
        qunit [OPTIONS...] Run JavaScript tests for this plugin or core
        url                Print the running environment's URL
        stop               Stop the container, retaining its data
        destroy            Delete this worktree's container and all its volumes
        auth-key           Save a reusable Tailscale key using a hidden prompt

      Saved per-worktree options for up:
        --preview          Build assets only after source changes; no frontend watcher
        --live             Restore continuous frontend rebuilding (initial default)
        --tailscale        Private HTTPS hostname using a Tailscale companion
        --no-tailscale      Stop the companion and disable Tailscale access
        --public-url URL   Set a public origin for your own reverse proxy
        --local            Restore the default local URL and stop the companion

      Run from any directory within a Discourse or plugin checkout/worktree.
      Plugin environments download and pin Discourse automatically.
      DWORKENV_DISCOURSE_REF selects the initial Discourse branch, tag, or commit.
      DWORKENV_CACHE_HOME overrides the managed checkout/cache directory.
      DWORKENV_IMAGE overrides the image for newly created containers.
      DWORKENV_TAILSCALE_AUTH_KEY_FILE overrides the reusable key's file path.
      DWORKENV_TAILSCALE_IMAGE overrides the image for new companions.
    HELP
    exit(command.nil? || %w[help --help -h].include?(command) ? 0 : 1)
  end
  abort "Supply a command after exec --" if command == "exec" && (ARGV - ["--"]).empty?
  abort "Unexpected arguments" if !%w[up exec test qunit].include?(command) && !ARGV.empty?

  begin
    if command == "auth-key"
      Dworkenv::Tailscale.store_key
    else
      WorktreeEnvironment.new.run(command, ARGV)
    end
  rescue StandardError => e
    abort "dworkenv: #{e.message}"
  end
end
